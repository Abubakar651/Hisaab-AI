# Groq Cloud API Key (Get yours from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default LLM Model (defaults to llama-3.3-70b-versatile or qwen/qwen3.8-27b)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Database URL
DATABASE_URL=sqlite:///./expenses.db

# App Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000

